{
  "manifest_version": 3,
  "name": "TelePort Cast & Remote",
  "version": "1.0.0",
  "description": "Beam tabs, cast screens, and control your TelePort TV directly from Chrome.",
  "permissions": [
    "tabs",
    "contextMenus",
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
